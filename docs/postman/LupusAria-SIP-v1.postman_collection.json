              "const resultBody = pm.response.json();",
              "pm.test('Response metadata', () => { pm.expect(resultBody.requestId).to.equal(pm.request.headers.get('X-Request-ID')); pm.expect(resultBody.sessionId).to.be.a('string'); pm.expect(resultBody.observedAt).to.be.a('string'); });",
              "pm.test('Expected result', () => { pm.expect(resultBody.features).to.have.lengthOf(10); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Save enabled feature while idle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Request-ID",
            "value": "postman-7"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/features",
        "body": {
          "mode": "raw",
          "raw": "{\"id\": \"raffle\", \"enabled\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const resultBody = pm.response.json();",
              "pm.test('Response metadata', () => { pm.expect(resultBody.requestId).to.equal(pm.request.headers.get('X-Request-ID')); pm.expect(resultBody.sessionId).to.be.a('string'); pm.expect(resultBody.observedAt).to.be.a('string'); });",
              "pm.test('Expected result', () => { const feature = resultBody.features.find(f => f.id === 'raffle'); pm.expect(feature.enabled).to.equal(true); pm.expect(feature.effective).to.equal(false); pm.expect(resultBody.operation.outcome).to.equal('success'); });"
            ]
          }
        }
      ]
    },
    {
