{
  "info": {
    "name": "LupusAria SIP v1 service smoke",
    "description": "Use an isolated, empty configuration. Lifecycle changes are intentionally exercised without production credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:47050"
    }
  ],
  "item": [
    {
      "name": "Discover service",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Request-ID",
            "value": "postman-1"
          }
        ],
        "url": "{{baseUrl}}/api/v1/app"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const resultBody = pm.response.json();",
              "pm.test('Response metadata', () => { pm.expect(resultBody.requestId).to.equal(pm.request.headers.get('X-Request-ID')); pm.expect(resultBody.sessionId).to.be.a('string'); pm.expect(resultBody.observedAt).to.be.a('string'); });",
              "pm.test('Expected result', () => { pm.expect(resultBody.appId).to.equal('lupusaria'); pm.expect(resultBody.mode).to.equal('service'); pm.expect(resultBody.protocolVersion).to.equal(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Service health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Request-ID",
            "value": "postman-2"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
